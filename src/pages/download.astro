---
// The download page. Each device sees its own part: the APK and how to install it on
// Android phones, a QR code on computers, a note on iPhones and iPads (docs/PLAN.md).
// Drawn like the rest of the site: the gold plate is the one action, the install steps
// are posts down a line, the fingerprints sit in ruled cells that never move.
import { renderSVG } from "uqr";
import BaseLayout from "../layouts/BaseLayout.astro";
import AppFacts from "../components/AppFacts.astro";
import DownloadButton from "../components/DownloadButton.astro";
import { apk, app } from "../config";
import { formatSize } from "../lib/download";

const fileName = `PreCut-${app.version}.apk`;
const size = apk.sizeBytes ? formatSize(apk.sizeBytes) : null;
// Dark squares on white, which phone cameras read most reliably.
const qr = renderSVG(new URL("/download", Astro.site).href, {
  ecc: "M",
  border: 2,
  pixelSize: 1,
});

const steps = [
  {
    title: "Download the APK",
    text: "with the button above. If your browser asks whether to keep the file, choose to download it.",
  },
  {
    title: "Open the file:",
    text: `tap Open in the download notification, or find ${fileName} in your Downloads.`,
  },
  {
    title: "Allow the install:",
    text: "if Android asks, tap Settings, turn on Allow from this source, then go back.",
  },
  {
    title: "Tap Install, then Open.",
    text: "Google Play Protect may check the app first. That's normal for apps from outside Google Play.",
  },
];
---

<BaseLayout
  title="Download"
  description={`Download ${app.name}, the video editor for Android: the APK, how to install it, and how to check it's genuine.`}
>
  <Fragment slot="head">
    <script is:inline>
      // Show the part of the page for this device before anything is drawn.
      (() => {
        const ua = navigator.userAgent;
        const ios =
          /iPhone|iPad|iPod/.test(ua) ||
          (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        document.documentElement.dataset.device = /Android/i.test(ua)
          ? "android"
          : ios
            ? "ios"
            : "desktop";
      })();
    </script>
  </Fragment>

  <div class="sheet">
    <section class="title-block" aria-labelledby="download-title">
      <h1 id="download-title" class="lettering">Download {app.name}</h1>
      <div class="facts"><AppFacts /></div>

      <div data-for="android" class="action">
        <DownloadButton
          id="apk"
          size="lg"
          href={apk.url}
          label="Download APK"
          class="w-full sm:w-auto"
        />
        <p id="started" role="status" class="status"></p>
      </div>

      <div data-for="ios" class="panel">
        <h2 class="lettering">{app.name} is on Android for now</h2>
        <p>
          There's no iPhone or iPad version yet. To get {app.name}, open this
          page on an Android phone.
        </p>
      </div>
    </section>

    <section data-for="android" class="steps" aria-labelledby="steps-title">
      <h2 id="steps-title" class="lettering">Install it in four steps</h2>
      <p class="lede">
        {app.name} isn't on Google Play yet, so you install it from here. It takes
        about a minute.
      </p>
      <ol>
        {steps.map((step, i) => (
          <li>
            <span class="post tabular" aria-hidden="true">{i + 1}</span>
            <p>
              <strong>{step.title}</strong> {step.text}
            </p>
          </li>
        ))}
      </ol>
      <p class="after">
        When there's a new version, download it here and install it over this
        one. Your projects stay.
      </p>
    </section>

    <section data-for="desktop" class="scan" aria-labelledby="scan-title">
      <div
        class="qr"
        role="img"
        aria-label="QR code that opens this page"
        set:html={qr}
      />
      <div>
        <h2 id="scan-title" class="lettering">Scan with your Android phone</h2>
        <p>
          {app.name} is an Android app. Point your phone's camera at the code to
          open this page there, then tap Download APK.
        </p>
        <a href={apk.url} class="link" data-download="apk-desktop">
          Or download the APK to this computer{size && ` (${size})`}
        </a>
      </div>
    </section>

    {
      apk.sha256 && apk.certSha256 && (
        <details class="genuine">
          <summary>
            <span>Check that the file is genuine</span>
            <span class="sign" aria-hidden="true" />
          </summary>
          <dl>
            <div>
              <dt class="label">SHA-256 of {fileName}</dt>
              <dd>{apk.sha256}</dd>
            </div>
            <div>
              <dt class="label">Signing certificate (SHA-256)</dt>
              <dd>{apk.certSha256}</dd>
            </div>
          </dl>
          <p>
            Every version of {app.name} is signed with this certificate, which is
            why a new version installs over the old one and keeps your projects.
          </p>
        </details>
      )
    }
  </div>

  <script is:inline define:vars={{ apkUrl: apk.url }}>
    // Arriving from a Download button (#start) on an Android phone starts the
    // download straight away, with the install steps already on screen.
    if (location.hash === "#start") {
      history.replaceState(null, "", location.pathname);
      if (document.documentElement.dataset.device === "android") {
        setTimeout(() => {
          document.getElementById("started").textContent =
            "Your download has started. If nothing happens, tap Download APK.";
          location.href = apkUrl;
        }, 600);
      }
    }
  </script>
</BaseLayout>

<style>
  .sheet {
    display: grid;
    gap: 3.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 3rem 1rem 5rem;
  }
  @media (min-width: 64rem) {
    .sheet {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 5rem;
      padding: 5rem 1.5rem 7rem;
    }
  }

  h1 {
    font-size: clamp(2.5rem, 10vw, 4.5rem);
    line-height: 1;
  }
  h2 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.05;
  }
  .facts {
    margin-top: 1.75rem;
  }
  .action {
    margin-top: 2.25rem;
  }
  .status {
    min-height: 1.5rem;
    margin-top: 0.75rem;
    color: var(--color-shadow);
  }

  .panel {
    margin-top: 2.25rem;
    padding: 1.5rem;
    border: 1px solid var(--color-poche);
    background: var(--color-mortar);
  }
  .panel p {
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  /* Install steps: numbered posts down a line. */
  .lede {
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--color-shadow);
    line-height: 1.6;
  }
  .steps ol {
    position: relative;
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .steps ol::before {
    content: "";
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 1.25rem;
    border-left: 2px dashed var(--color-stone);
  }
  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }
  .post {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-poche);
    color: var(--color-sun);
    font-size: 1.25rem;
  }
  .steps li p {
    padding-top: 0.4rem;
    line-height: 1.6;
  }
  .steps strong {
    font-weight: 600;
  }
  .after {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-poche) 40%, transparent);
    color: var(--color-shadow);
  }

  /* The QR code on a white plate with a drawing's corner marks. */
  .scan {
    display: grid;
    align-content: start;
    gap: 2rem;
  }
  @media (min-width: 40rem) {
    .scan {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }
  }
  .qr {
    position: relative;
    width: 12rem;
    padding: 0.75rem;
    background: #fff;
    box-shadow: 0 0 0 1px var(--color-poche);
  }
  .qr::before,
  .qr::after {
    content: "";
    position: absolute;
    width: 1rem;
    height: 1rem;
    border: 0 solid var(--color-poche);
  }
  .qr::before {
    top: -0.6rem;
    left: -0.6rem;
    border-top-width: 2px;
    border-left-width: 2px;
  }
  .qr::after {
    right: -0.6rem;
    bottom: -0.6rem;
    border-right-width: 2px;
    border-bottom-width: 2px;
  }
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    shape-rendering: crispEdges;
  }
  .scan p {
    max-width: 30rem;
    margin-top: 0.9rem;
    line-height: 1.6;
  }
  .link {
    display: inline-block;
    margin-top: 1rem;
    padding-block: 0.5rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-sun);
    text-decoration-thickness: 2px;
  }
  .link:hover {
    text-decoration-color: var(--color-poche);
  }

  /* The fingerprints, in ruled cells. */
  .genuine {
    border-top: 1px solid var(--color-poche);
    border-bottom: 1px solid color-mix(in srgb, var(--color-poche) 40%, transparent);
  }
  @media (min-width: 64rem) {
    .genuine {
      grid-column: 1 / -1;
    }
  }
  .genuine summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.75rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-style: italic;
    list-style: none;
  }
  .genuine summary::-webkit-details-marker {
    display: none;
  }
  .sign {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .sign::before,
  .sign::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-poche);
  }
  .sign::after {
    rotate: 90deg;
  }
  .genuine[open] .sign::after {
    rotate: 0deg;
  }
  /* High-contrast mode drops background colours, which would hide the plus and minus. */
  @media (forced-colors: active) {
    .sign::before,
    .sign::after {
      background: CanvasText;
    }
  }
  .genuine dl {
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--color-poche) 40%, transparent);
  }
  @media (min-width: 64rem) {
    .genuine dl {
      grid-template-columns: 1fr 1fr;
    }
    .genuine dl div + div {
      padding-left: 1.5rem;
      border-left: 1px solid color-mix(in srgb, var(--color-poche) 40%, transparent);
    }
  }
  .genuine dl div {
    padding-block: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-poche) 40%, transparent);
  }
  .genuine dt {
    color: var(--color-shadow);
    font-size: 0.75rem;
  }
  .genuine dd {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .genuine > p {
    max-width: 44rem;
    padding-block: 1rem 1.5rem;
    color: var(--color-shadow);
    line-height: 1.6;
  }

  /* Only the part for this device. Without JavaScript, Android and computer both show. */
  :global(html[data-device="android"]) [data-for]:not([data-for~="android"]),
  :global(html[data-device="ios"]) [data-for]:not([data-for~="ios"]),
  :global(html[data-device="desktop"]) [data-for]:not([data-for~="desktop"]),
  :global(html:not([data-device])) [data-for="ios"] {
    display: none;
  }
</style>
