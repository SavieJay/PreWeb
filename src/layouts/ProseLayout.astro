---
// Text pages: privacy policy, terms, data deletion, support.
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  /** "Last updated" date, for the legal pages. */
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="prose mx-auto max-w-2xl px-4 pt-14 pb-20 sm:pt-20">
    <h1 class="text-4xl font-bold tracking-tight text-fg sm:text-5xl">
      {title}
    </h1>
    {updated && <p class="updated">Last updated {updated}</p>}
    <slot />
  </article>
</BaseLayout>

<style>
  .prose {
    color: color-mix(in srgb, var(--color-fg) 88%, transparent);
    line-height: 1.7;
  }
  .updated {
    margin-top: 0.75rem;
    color: var(--color-fg-muted);
  }
  .prose :global(h2) {
    margin-top: 2.75rem;
    color: var(--color-fg);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    color: var(--color-fg);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(dl) {
    margin-top: 1rem;
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose :global(ol) {
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .prose :global(li + li) {
    margin-top: 0.6rem;
  }
  .prose :global(li::marker) {
    color: var(--color-fg-muted);
  }
  .prose :global(strong),
  .prose :global(dt) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .prose :global(dd + dt) {
    margin-top: 1.5rem;
  }
  .prose :global(dd) {
    margin-top: 0.35rem;
  }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .prose :global(.card) {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.05);
    border-radius: 1.25rem;
    background: var(--color-ink-1);
  }
  .prose :global(.card > :first-child) {
    margin-top: 0;
  }
</style>
