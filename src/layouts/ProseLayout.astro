---
// Text pages: privacy policy, terms, data deletion, support. The same drawing, read
// quietly: an inclined title, the date as a readout, a single ruled column of text.
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  /** "Last updated" date, for the legal pages. */
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="page">
    <header class="head">
      <h1 class="lettering">{title}</h1>
      {
        updated && (
          <p class="updated">
            <span class="label">Last updated</span>
            <span class="tabular">{updated}</span>
          </p>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: 80rem;
    margin-inline: auto;
    padding: 3rem 1rem 5rem;
  }
  @media (min-width: 64rem) {
    .page {
      display: grid;
      grid-template-columns: minmax(0, 22rem) minmax(0, 44rem);
      gap: 4rem;
      padding: 5rem 1.5rem 7rem;
    }
    /* The title block stays in view beside the long text. */
    .head {
      position: sticky;
      top: 7.5rem;
      align-self: start;
    }
  }

  h1 {
    font-size: clamp(2.5rem, 9vw, 4rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .updated {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-poche) 40%, transparent);
  }
  .updated .label {
    color: var(--color-shadow);
    font-size: 0.75rem;
  }
  .updated .tabular {
    font-size: 1.25rem;
  }

  .prose {
    max-width: 62ch;
    margin-top: 2.5rem;
    color: color-mix(in srgb, var(--color-poche) 90%, var(--color-lime));
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  @media (min-width: 64rem) {
    .prose {
      margin-top: 0;
    }
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-poche);
    color: var(--color-poche);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    color: var(--color-poche);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(dl) {
    margin-top: 1rem;
  }
  .prose :global(h2 + p),
  .prose :global(h2 + ul),
  .prose :global(h2 + dl) {
    margin-top: 0.85rem;
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
    list-style: square;
  }
  .prose :global(ol) {
    padding-left: 1.5rem;
    list-style: decimal;
  }
  .prose :global(li + li) {
    margin-top: 0.6rem;
  }
  .prose :global(li::marker) {
    color: var(--color-sun-ink);
  }
  .prose :global(strong),
  .prose :global(dt) {
    color: var(--color-poche);
    font-weight: 600;
  }
  .prose :global(dd + dt) {
    margin-top: 1.5rem;
  }
  .prose :global(dd) {
    margin-top: 0.35rem;
  }
  .prose :global(a) {
    color: var(--color-poche);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-sun);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--color-poche);
  }
  /* A boxed note, ruled like a drawing's notes block. */
  .prose :global(.card) {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-poche);
    background: var(--color-mortar);
  }
  .prose :global(.card > :first-child) {
    margin-top: 0;
  }
</style>
