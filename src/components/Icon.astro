---
// Line icons drawn for the site, one 1.5 px stroke on a 24 px grid, like the
// annotations on a section drawing. Decorative unless a label is passed.

const paths = {
  "arrow-right": "M4 12h15M13 6l6 6-6 6",
  "arrow-down": "M12 4v15M6 13l6 6 6-6",
  download: "M12 3.5v11M7 10l5 5 5-5M4.5 20h15",
  tag: "M3.5 12.5l9-9h8v8l-9 9zM16 8h.01",
  file: "M6.5 3.5h7.5l4 4v13h-11.5zM14 3.5v4h4",
  phone: "M8 3.5h8a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 19V5A1.5 1.5 0 0 1 8 3.5zM11 17.5h2",
  sun: "M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zM12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8",
  clock: "M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17zM12 7.5V12l3 2",
  check: "M5 12.5l4.5 4.5L19 7.5",
  wave: "M3 12h2M7 9v6M10 6v12M13 9v6M16 7.5v9M19 10.5v3M21 12h.01",
  lock: "M7 10.5V8a5 5 0 0 1 10 0v2.5M5.5 10.5h13v10h-13zM12 14.5v2.5",
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
  /** Accessible name; without one the icon is hidden from assistive tech. */
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["shrink-0", className]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
>
  <path d={paths[name]}></path>
</svg>
