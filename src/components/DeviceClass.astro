---
// Marks <html data-device="android|ios|desktop"> before anything is drawn, so a page
// shows only its part for this device ([data-for], in global.css).
---

<script is:inline>
  (() => {
    const ua = navigator.userAgent;
    const ios =
      /iPhone|iPad|iPod/.test(ua) ||
      (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    document.documentElement.dataset.device = /Android/i.test(ua)
      ? "android"
      : ios
        ? "ios"
        : "desktop";
  })();
</script>
