---
// A frosted-glass tile that floats next to the phone (decorative).

interface Props {
  class?: string;
  /** Which way the tile leans; tiles on the right lean the other way. */
  lean?: "left" | "right";
  /** Offsets the float animation so tiles don't move in step. */
  delay?: string;
}

const { class: className, lean = "left", delay = "0s" } = Astro.props;
---

<div
  class:list={["float absolute", className]}
  style={`--delay: ${delay}`}
  aria-hidden="true"
>
  <div class="tile" data-lean={lean}>
    <slot />
  </div>
</div>

<style>
  .float {
    width: clamp(4.5rem, 21%, 7.5rem);
    aspect-ratio: 1;
    animation: float 7s ease-in-out var(--delay) infinite;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 22%;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: linear-gradient(
      140deg,
      rgb(255 255 255 / 0.16),
      rgb(255 255 255 / 0.03) 60%,
      rgb(255 77 109 / 0.1)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.3),
      inset 0 -12px 28px -14px rgb(255 77 109 / 0.55),
      0 24px 40px -16px rgb(0 0 0 / 0.75);
    backdrop-filter: blur(10px);
    color: var(--color-on-accent-container);
    transform: perspective(500px) rotateX(26deg) rotateY(-22deg) rotateZ(-8deg);
  }

  .tile[data-lean="right"] {
    transform: perspective(500px) rotateX(24deg) rotateY(22deg) rotateZ(9deg);
  }

  .tile :global(svg) {
    width: 52%;
    height: 52%;
    filter: drop-shadow(0 0 10px rgb(255 77 109 / 0.6));
  }

  @keyframes float {
    50% {
      translate: 0 -10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float {
      animation: none;
    }
  }
</style>
