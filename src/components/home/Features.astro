---
// Six feature cards, each with a small drawn illustration in the app's colours.
// Real screenshots or clips can replace the illustrations later (docs/PLAN.md, W2).
import { catalogue } from "../../config";

const filters = [
  { name: "Original", filter: "none" },
  { name: "Life", filter: "saturate(1.35) brightness(1.05)" },
  { name: "Portrait", filter: "sepia(0.25) saturate(1.15) brightness(1.1)" },
  { name: "Film", filter: "contrast(1.1) sepia(0.4) hue-rotate(-12deg)" },
  { name: "Movie", filter: "contrast(1.2) saturate(0.85) hue-rotate(170deg)" },
  { name: "Night", filter: "brightness(0.7) hue-rotate(205deg) saturate(1.3)" },
];
---

<section id="features" class="below-fold mx-auto max-w-6xl px-4 py-20 sm:py-28">
  <div class="reveal mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-5xl">
      Everything you need to edit,
      <span class="text-accent">right on your phone</span>
    </h2>
    <p class="mt-4 text-lg text-fg-muted">
      A full timeline and the tools around it. Every one of them free, with no
      watermark.
    </p>
  </div>

  <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    <article class="card reveal">
      <div class="visual v-timeline" aria-hidden="true">
        <div class="tl-row">
          <span class="tl-clip a"></span>
          <span class="tl-clip b sel"></span>
          <span class="tl-clip c"></span>
        </div>
        <div class="tl-row">
          <span class="tl-lane text">T&nbsp;Title</span>
        </div>
        <div class="tl-row">
          <span class="tl-lane music"></span>
        </div>
        <span class="tl-playhead"></span>
      </div>
      <h3>Edit on a timeline</h3>
      <p>
        Trim, split, reorder and replace clips, with snapping to edges, beats
        and the playhead. Speed from <span class="font-mono">0.1x</span> to
        <span class="font-mono">100x</span> with smooth curves, reverse and
        freeze frames. Every change can be undone, and drafts save as you go.
      </p>
    </article>

    <article class="card reveal">
      <div class="visual v-beats" aria-hidden="true">
        <div class="beat-wave"></div>
        <div class="beat-clips">
          <span class="a"></span>
          <span class="b"></span>
          <span class="c"></span>
          <span class="d"></span>
        </div>
      </div>
      <h3>AutoCut and templates</h3>
      <p>
        Pick your clips and a song: AutoCut finds the beats and cuts each clip
        to them. Or start from one of{" "}
        <span class="font-mono">{catalogue.templates}</span> templates, drop in
        your clips and change the words. Any project can become a template.
      </p>
    </article>

    <article class="card reveal">
      <div class="visual v-filters" aria-hidden="true">
        {filters.map((f) => (
          <figure>
            <span class="swatch" style={`filter: ${f.filter}`} />
            <figcaption>{f.name}</figcaption>
          </figure>
        ))}
      </div>
      <h3>Filters, effects and transitions</h3>
      <p>
        <span class="font-mono">{catalogue.filters}</span> filters plus your own
        .cube LUTs, <span class="font-mono">{catalogue.effects}</span> effects
        from glitch to light leaks, and{" "}
        <span class="font-mono">{catalogue.transitions}</span> transitions.
        Keyframes with easing curves animate movement, opacity, masks and
        colour.
      </p>
    </article>

    <article class="card reveal">
      <div class="visual v-text" aria-hidden="true">
        <span class="t-outline">Weekend</span>
        <span class="t-glow">vlog</span>
        <span class="t-pill">Day 1</span>
      </div>
      <h3>Text and stickers</h3>
      <p>
        Styled text in <span class="font-mono">{catalogue.fonts}</span> fonts or
        your own, with outline, glow, curved text and animations.{" "}
        <span class="font-mono">{catalogue.textTemplates}</span> one-tap text
        templates, text to speech, emoji, animated and 3D stickers, GIFs and
        drawing.
      </p>
    </article>

    <article class="card reveal">
      <div class="visual v-layers" aria-hidden="true">
        <div class="layer-frame">
          <span class="layer-pip"></span>
          <span class="layer-star"></span>
          <span class="layer-chip">Screen</span>
        </div>
        <div class="layer-lanes">
          <span class="music"></span>
          <span class="voice"></span>
        </div>
      </div>
      <h3>Layers, music and voice</h3>
      <p>
        Picture-in-picture with blend modes, masks and chroma key. Several music
        tracks with their own volume and fades, voiceovers with voice effects,
        and the sound from any video.
      </p>
    </article>

    <article class="card reveal">
      <div class="visual v-export" aria-hidden="true">
        <div class="sheet">
          <div class="seg">
            <span>720p</span>
            <span>1080p</span>
            <span class="on">4K</span>
          </div>
          <div class="seg">
            <span>24</span>
            <span>30</span>
            <span class="on">60 fps</span>
          </div>
          <div class="chips">
            <span>HEVC</span>
            <span>HDR</span>
            <span class="ok">No watermark</span>
          </div>
        </div>
      </div>
      <h3>Export up to 4K, no watermark</h3>
      <p>
        <span class="font-mono">480p</span> to <span class="font-mono">4K</span>{" "}
        at
        <span class="font-mono">24</span> to <span class="font-mono">60</span>{" "}
        fps, H.264 or HEVC, and HDR where your phone supports it. Exports keep
        running in the background. Save a GIF, just the audio, or a single frame
        as a photo.
      </p>
    </article>
  </div>
</section>

<style>
  .card {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.06);
    border-radius: 1.5rem;
    background: var(--color-ink-1);
    padding-bottom: 1.5rem;
  }
  .card h3 {
    margin: 1.5rem 1.5rem 0;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .card p {
    margin: 0.6rem 1.5rem 0;
    color: var(--color-fg-muted);
    line-height: 1.65;
  }

  .visual {
    position: relative;
    height: 11rem;
    overflow: hidden;
    background:
      radial-gradient(
        80% 90% at 50% 120%,
        rgb(92 20 38 / 0.45),
        transparent 70%
      ),
      var(--color-ink-0);
    border-bottom: 1px solid rgb(255 255 255 / 0.05);
  }

  /* Timeline */
  .v-timeline {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: 0 1.25rem;
  }
  .tl-row {
    display: flex;
    gap: 3px;
    height: 1.1rem;
  }
  .tl-row:first-child {
    height: 2.6rem;
  }
  .tl-clip {
    position: relative;
    height: 100%;
    border-radius: 0.4rem;
    background-image:
      repeating-linear-gradient(
        90deg,
        transparent 0 1.9rem,
        rgb(0 0 0 / 0.35) 1.9rem 2rem
      ),
      var(--thumb);
  }
  .tl-clip.a {
    flex: 3;
    --thumb: linear-gradient(135deg, #ffb26b, #d94f3d 60%, #5c1426);
  }
  .tl-clip.b {
    flex: 2.4;
    --thumb: linear-gradient(135deg, #3fb7a6, #137d6f 55%, #0b3a3a);
  }
  .tl-clip.c {
    flex: 3.4;
    --thumb: linear-gradient(135deg, #b48cff, #7b5bd6 50%, #2a1a55);
  }
  .tl-clip.sel {
    outline: 2px solid #fff;
    outline-offset: 1px;
  }
  .tl-lane {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 0.5rem;
    border-radius: 0.35rem;
    font-size: 0.7rem;
    font-weight: 600;
  }
  .tl-lane.text {
    width: 45%;
    margin-left: 18%;
    background: var(--color-lane-text);
    color: var(--color-ink-0);
  }
  .tl-lane.music {
    width: 100%;
    background:
      repeating-linear-gradient(
          90deg,
          rgb(255 255 255 / 0.6) 0 2px,
          transparent 2px 5px
        )
        0 50% / 100% 55% no-repeat,
      var(--color-lane-music);
  }
  .tl-playhead {
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    left: 52%;
    width: 2px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(14 14 16 / 0.4);
  }

  /* AutoCut: clips cut on the music's beats (yellow, as in the app) */
  .v-beats {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.8rem;
    padding: 0 1.25rem;
    --beat: rgb(255 212 59 / 0.85);
  }
  .v-beats::before {
    content: "";
    position: absolute;
    inset: 1.75rem 1.25rem;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 calc(25% - 1px),
      var(--beat) calc(25% - 1px) 25%
    );
    opacity: 0.55;
  }
  .beat-wave {
    position: relative;
    height: 2.2rem;
    border-radius: 0.4rem;
    background:
      radial-gradient(circle, var(--beat) 0 3px, transparent 3.5px) 0 100% / 25%
        9px repeat-x,
      repeating-linear-gradient(
          90deg,
          rgb(255 255 255 / 0.65) 0 2px,
          transparent 2px 5px
        )
        0 40% / 100% 60% no-repeat,
      var(--color-lane-music);
  }
  .beat-clips {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    height: 2.6rem;
  }
  .beat-clips span {
    border-radius: 0.4rem;
  }
  .beat-clips .a {
    background: linear-gradient(135deg, #ffb26b, #d94f3d);
  }
  .beat-clips .b {
    background: linear-gradient(135deg, #3fb7a6, #137d6f);
  }
  .beat-clips .c {
    background: linear-gradient(135deg, #b48cff, #7b5bd6);
  }
  .beat-clips .d {
    background: linear-gradient(135deg, #ffd9a0, #e07a2e);
  }

  /* Filters: the same little scene through six looks */
  .v-filters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-content: center;
    gap: 0.6rem 0.75rem;
    padding: 0 1.5rem;
  }
  .v-filters figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }
  .swatch {
    width: 100%;
    height: 3rem;
    border-radius: 0.5rem;
    background:
      radial-gradient(circle at 50% 62%, #ffe2b8 0 14%, transparent 15%),
      linear-gradient(transparent 70%, #2a1030 70%),
      linear-gradient(180deg, #1d0f3a, #6b1f4e 45%, #ff4d6d 75%, #ffb26b);
  }
  .v-filters figure:first-child .swatch {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .v-filters figcaption {
    color: var(--color-fg-muted);
    font-size: 0.75rem;
  }

  /* Text styles */
  .v-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }
  .t-outline {
    color: transparent;
    font-size: 2.1rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
    -webkit-text-stroke: 1.5px #fff;
  }
  .t-glow {
    color: #fff;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    text-shadow:
      0 0 12px rgb(255 77 109 / 0.9),
      0 0 28px rgb(255 77 109 / 0.6);
  }
  .t-pill {
    margin-top: 0.3rem;
    padding: 0.15rem 0.7rem;
    border-radius: 0.4rem;
    background: var(--color-lane-text);
    color: var(--color-ink-0);
    font-size: 1rem;
    font-weight: 700;
  }

  /* Layers: a picture-in-picture with a blend mode and a star mask, over two audio lanes */
  .v-layers {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding: 0 1.25rem;
  }
  .layer-frame {
    position: relative;
    height: 5.2rem;
    overflow: hidden;
    border-radius: 0.6rem;
    background: linear-gradient(160deg, #1d0f3a, #6b1f4e 50%, #ff4d6d);
    isolation: isolate;
  }
  .layer-pip {
    position: absolute;
    top: 0.6rem;
    right: 0.8rem;
    width: 38%;
    height: 70%;
    border: 2px solid #fff;
    border-radius: 0.4rem;
    background: linear-gradient(135deg, #3fb7a6, #2f6fb8);
    mix-blend-mode: screen;
  }
  .layer-star {
    position: absolute;
    left: 1rem;
    top: 0.9rem;
    width: 3.4rem;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #ffd9a0, #e07a2e);
    clip-path: polygon(
      50% 0%,
      61% 35%,
      98% 35%,
      68% 57%,
      79% 91%,
      50% 70%,
      21% 91%,
      32% 57%,
      2% 35%,
      39% 35%
    );
  }
  .layer-chip {
    position: absolute;
    right: 0.8rem;
    bottom: 0.45rem;
    padding: 0.05rem 0.45rem;
    border-radius: 99px;
    background: rgb(14 14 16 / 0.8);
    color: var(--color-fg);
    font-size: 0.65rem;
  }
  .layer-lanes {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .layer-lanes span {
    height: 0.9rem;
    border-radius: 0.3rem;
    background:
      repeating-linear-gradient(
          90deg,
          rgb(255 255 255 / 0.6) 0 2px,
          transparent 2px 5px
        )
        0 50% / 100% 55% no-repeat,
      var(--lane);
  }
  .layer-lanes .music {
    --lane: var(--color-lane-music);
  }
  .layer-lanes .voice {
    width: 55%;
    margin-left: 25%;
    --lane: var(--color-lane-voice);
  }

  /* Export settings sheet */
  .v-export {
    display: grid;
    place-items: center;
    padding: 0 1.25rem;
  }
  .sheet {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    max-width: 18rem;
    padding: 0.9rem;
    border-radius: 0.9rem;
    background: var(--color-ink-1);
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.7);
  }
  .seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    border: 1px solid var(--color-outline);
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
  }
  .seg span {
    padding: 0.3rem 0;
    color: var(--color-fg-muted);
  }
  .seg span + span {
    border-left: 1px solid var(--color-outline);
  }
  .seg .on {
    background: var(--color-accent-container);
    color: var(--color-on-accent-container);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.75rem;
  }
  .chips span {
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    background: var(--color-ink-2);
  }
  .chips .ok {
    margin-left: auto;
    background: rgb(56 217 169 / 0.15);
    color: #38d9a9;
  }
</style>
