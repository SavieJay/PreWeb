---
// The most common questions; the full list is on /support.
import { app } from "../../config";

const items = [
  {
    q: `Is ${app.name} free?`,
    a: "Yes. Every tool is free, with no watermark on exports, no ads and no account.",
  },
  {
    q: `Does ${app.name} upload my videos?`,
    a: "No. Your videos, photos and projects stay on your phone. Optional cloud AI features send only the sound, and only after you agree each time.",
  },
  {
    q: "Which phones does it work on?",
    a: `Android phones running Android ${app.minAndroid} or newer.`,
  },
  {
    q: "Why isn't it on Google Play?",
    a: `${app.name} isn't on Google Play yet. Until it is, this website is the place to get it, and the download page shows how to install it.`,
  },
  {
    q: "How do I update?",
    a: "Download the new version from the download page and install it over the old one. Your projects stay.",
  },
  {
    q: "Is there an iPhone version?",
    a: `Not yet. ${app.name} is on Android for now.`,
  },
];
---

<section class="mx-auto max-w-3xl px-4 py-20 sm:py-28">
  <h2 class="reveal text-center text-3xl font-bold tracking-tight sm:text-5xl">
    Questions
  </h2>
  <div class="mt-10 space-y-3">
    {items.map((item) => (
      <details class="reveal faq">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
  <p class="reveal mt-8 text-center text-fg-muted">
    More answers on the
    <a href="/support" class="text-accent underline underline-offset-4">support page</a>.
  </p>
</section>

<style>
  .faq {
    border: 1px solid rgb(255 255 255 / 0.06);
    border-radius: 1.25rem;
    background: var(--color-ink-1);
  }
  summary {
    position: relative;
    padding: 1.1rem 3.25rem 1.1rem 1.25rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* A plus that turns into a minus */
  summary::before,
  summary::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 1.4rem;
    width: 0.8rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    transition: rotate 0.2s ease;
  }
  summary::after {
    rotate: 90deg;
  }
  .faq[open] summary::after {
    rotate: 0deg;
  }
  .faq p {
    padding: 0 1.25rem 1.25rem;
    color: var(--color-fg-muted);
    line-height: 1.65;
  }
  @media (prefers-reduced-motion: reduce) {
    summary::before,
    summary::after {
      transition: none;
    }
  }
</style>
