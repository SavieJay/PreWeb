---
// The drawing's button: a slanted plate with chamfered ends, labelled in inclined caps.
// The plate is drawn on ::before (and its inner face on ::after for outlines), so the
// link itself stays a rectangle and its focus ring isn't clipped.
import Icon from "./Icon.astro";

interface Props {
  href: string;
  /** sun: gold plate (the primary action). poche: charcoal plate with gold label.
      outline: charcoal line on limewash. outline-light: limewash line on the slab. */
  variant?: "sun" | "poche" | "outline" | "outline-light";
  size?: "sm" | "md" | "lg";
  icon?: "download" | "arrow-right" | "arrow-down";
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  variant = "sun",
  size = "md",
  icon,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={["plate", `plate-${variant}`, `plate-${size}`, className]}
  {...rest}
>
  <span class="plate-label"><slot /></span>
  {icon && <Icon name={icon} class="plate-icon" />}
</a>

<style>
  .plate {
    --cut: 0.7rem;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding-inline: calc(var(--cut) + 1rem);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s var(--ease-out-expo);
  }
  .plate::before,
  .plate::after {
    content: "";
    position: absolute;
    z-index: -1;
    /* A parallelogram: both ends lean the way the lettering does. */
    clip-path: polygon(
      var(--cut) 0,
      100% 0,
      calc(100% - var(--cut)) 100%,
      0 100%
    );
    transition:
      background-color 0.2s var(--ease-out-expo),
      translate 0.25s var(--ease-out-expo);
  }
  .plate::before {
    inset: 0;
    background: var(--plate);
  }
  .plate::after {
    inset: 1.5px 2px;
    background: var(--face, transparent);
  }

  .plate-sm {
    --cut: 0.5rem;
    min-height: 2.5rem;
    font-size: 0.875rem;
    gap: 0.6rem;
    padding-inline: calc(var(--cut) + 0.7rem);
  }
  .plate-md {
    min-height: 3rem;
    font-size: 1rem;
  }
  .plate-lg {
    min-height: 3.5rem;
    font-size: 1.125rem;
  }

  .plate-sun {
    --plate: var(--color-sun);
    color: var(--color-poche);
  }
  .plate-sun:hover {
    --plate: #e2b44f;
  }
  .plate-sun:active {
    --plate: #c4932c;
  }

  .plate-poche {
    --plate: var(--color-poche);
    color: var(--color-sun);
  }
  .plate-poche:hover {
    --plate: var(--color-poche-2);
  }

  .plate-outline {
    --plate: var(--color-poche);
    --face: var(--color-lime);
    color: var(--color-poche);
  }
  .plate-outline:hover {
    --face: var(--color-lime-2);
  }

  .plate-outline-light {
    --plate: var(--color-lime);
    --face: var(--color-poche);
    color: var(--color-lime);
  }
  .plate-outline-light:hover {
    --face: var(--color-poche-2);
  }

  .plate-label {
    /* Italic caps sit a hair low in their box; this centres them optically. */
    padding-top: 0.08em;
  }
  .plate :global(.plate-icon) {
    width: 1.25em;
    height: 1.25em;
    transition: translate 0.25s var(--ease-out-expo);
  }
  .plate:hover :global(.plate-icon) {
    translate: 0.15em 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .plate:hover :global(.plate-icon) {
      translate: none;
    }
  }
</style>
