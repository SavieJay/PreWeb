---
// "Version 1.0.0 · Android 8.0 or newer · 8.9 MB · Free", numbers in Roboto Mono.
// Built from a list so the separators' spaces survive line wrapping in the source.
import { apk, app } from "../config";
import { formatSize } from "../lib/download";

interface Props {
  class?: string;
  style?: string;
}

const facts = [
  { before: "Version ", number: app.version, after: "" },
  { before: "Android ", number: app.minAndroid, after: " or newer" },
  ...(apk.sizeBytes
    ? [
        {
          before: "",
          number: formatSize(apk.sizeBytes).replace(" MB", ""),
          after: " MB",
        },
      ]
    : []),
  { before: "Free", number: "", after: "" },
];
---

<p class={Astro.props.class} style={Astro.props.style}>
  {facts.map((fact, i) => (
    <>
      {i > 0 && " · "}
      {fact.before}
      {fact.number && <span class="font-mono">{fact.number}</span>}
      {fact.after}
    </>
  ))}
</p>
