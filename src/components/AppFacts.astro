---
// The app's facts as a drawing's readouts: an icon, a small inclined label and a
// tabular value, split by vertical hairlines. Two by two on narrow phones.
import Icon from "./Icon.astro";
import { apk, app } from "../config";
import { formatSize } from "../lib/download";

interface Props {
  class?: string;
  /** Which ground the readouts sit on. */
  tone?: "lime" | "slab";
}

const { class: className, tone = "lime" } = Astro.props;

interface Fact {
  icon: "tag" | "file" | "phone" | "sun";
  label: string;
  value: string;
}

const facts: Fact[] = [
  { icon: "tag", label: "Version", value: app.version },
  ...(apk.sizeBytes
    ? [{ icon: "file", label: "Size", value: formatSize(apk.sizeBytes) } as Fact]
    : []),
  { icon: "phone", label: "Android", value: `${app.minAndroid} or newer` },
  { icon: "sun", label: "Price", value: "Free" },
];
---

<dl class:list={["readouts", `tone-${tone}`, className]}>
  {facts.map((fact) => (
    <div class="readout">
      <dt class="label">
        <Icon name={fact.icon} class="readout-icon" />
        {fact.label}
      </dt>
      <dd class="tabular readout-value">{fact.value}</dd>
    </div>
  ))}
</dl>

<style>
  .readouts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }
  /* A dt/dd pair; the icon lives in the dt (so the list stays valid) and is drawn
     in the pair's left padding, centred on both lines. */
  .readout {
    --pad: 0rem;
    position: relative;
    padding: 0.85rem 0.75rem 0.85rem calc(var(--pad) + 2.3rem);
    border-bottom: 1px solid var(--rule);
  }
  .readout:nth-child(even) {
    --pad: 0.9rem;
    border-left: 1px solid var(--rule);
  }
  @media (min-width: 40rem) {
    .readouts {
      display: flex;
      flex-wrap: wrap;
      border-top: 0;
    }
    .readout,
    .readout:nth-child(even) {
      --pad: 1.4rem;
      padding-block: 0.15rem;
      padding-right: 1.4rem;
      border-bottom: 0;
      border-left: 1px solid var(--rule);
    }
    .readout:first-child {
      --pad: 0rem;
      border-left: 0;
    }
  }

  .tone-lime {
    --rule: color-mix(in srgb, var(--color-poche) 30%, transparent);
    --label: var(--color-shadow);
  }
  .tone-slab {
    --rule: color-mix(in srgb, var(--color-lime) 22%, transparent);
    --label: var(--color-dusk);
  }

  .readout :global(.readout-icon) {
    position: absolute;
    top: 50%;
    left: var(--pad);
    width: 1.6rem;
    height: 1.6rem;
    color: var(--label);
    translate: 0 -50%;
  }
  dt {
    color: var(--label);
    font-size: 0.75rem;
  }
  .readout-value {
    margin-top: 0.15rem;
    font-size: 1.125rem;
    line-height: 1.2;
    white-space: nowrap;
  }
</style>
