---
import Button from "./Button.astro";
import { downloadHref } from "../lib/download";

interface Props {
  /** Names the button in the Play referrer and in click counts, e.g. "header" or "hero". */
  id: string;
  /** compact: the header's charcoal plate. lg: the gold plate of a page's main call. */
  size?: "compact" | "lg";
  class?: string;
  /** Overrides where the button goes, e.g. straight to the APK on the download page. */
  href?: string;
  /** Overrides the large button's label. */
  label?: string;
}

const {
  id,
  size = "compact",
  class: className,
  href = downloadHref(id),
  label = "Download for Android",
} = Astro.props;
---

{
  size === "lg" ? (
    <Button
      href={href}
      variant="sun"
      size="lg"
      icon="download"
      class={className}
      data-download={id}
    >
      {label}
    </Button>
  ) : (
    <Button
      href={href}
      variant="poche"
      size="sm"
      icon="download"
      class={className}
      data-download={id}
    >
      Download<span class="sr-only"> PreCut</span>
    </Button>
  )
}
