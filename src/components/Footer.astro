---
import { legalName } from "../config";

// The pages behind these links are built in Phase W1.
const links = [
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/delete-data", label: "Delete my data" },
  { href: "/support", label: "Support" },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-ink-1">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between">
    <nav aria-label="Legal and support">
      <ul class="flex flex-wrap gap-x-6 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-block py-2 text-fg-muted transition-colors hover:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="text-sm text-fg-muted">
      © <span class="font-mono">{year}</span> {legalName}
    </p>
  </div>
</footer>
