---
// The end of the sheet, on the charcoal slab: legal links and the publisher.
import Logo from "./Logo.astro";
import { app, legalName } from "../config";

const links = [
  { href: "/download", label: "Download" },
  { href: "/support", label: "Support" },
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/delete-data", label: "Delete my data" },
];
const year = new Date().getFullYear();
---

<footer class="slab site-footer">
  <div class="in">
    <a href="/" class="brand">
      <Logo class="brand-mark" />
      <span class="wordmark">{app.name}</span>
    </a>
    <nav aria-label="Site">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class="label">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="label note">
      © <span class="tabular">{year}</span>
      {legalName}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--color-lime) 16%, transparent);
  }
  .in {
    display: grid;
    gap: 1.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2.5rem 1rem 3rem;
  }
  @media (min-width: 64rem) {
    .in {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2.5rem;
      padding-inline: 1.5rem;
    }
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    color: var(--color-lime);
    text-decoration: none;
  }
  .brand :global(.brand-mark) {
    width: 1.2rem;
    height: auto;
  }
  .wordmark {
    padding-top: 0.1em;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    margin-inline: -0.75rem;
  }
  nav a {
    display: block;
    padding: 0.75rem;
    color: var(--color-dusk);
    font-size: 0.875rem;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--color-lime);
    text-decoration: underline;
    text-decoration-color: var(--color-sun);
    text-decoration-thickness: 2px;
  }
  .note {
    color: var(--color-dusk);
    font-size: 0.75rem;
  }
</style>
